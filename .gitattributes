# Normalize line endings in the repo; check out native on Windows.
* text=auto eol=lf

# Windows-native scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated; collapse in PR diffs.
pnpm-lock.yaml linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
