# Database
# DATABASE_URL: runtime connection used by apps/api and apps/worker. After
# the first `pnpm --filter @aione/db migrate` run, this should point at the
# restricted `aione_app` role (UPDATE/DELETE revoked on approvals) rather
# than the bootstrap `aione` role shown below — set aione_app's password
# yourself (e.g. `ALTER ROLE aione_app WITH PASSWORD '...'`), it is never
# written by a migration or by this file.
DATABASE_URL=postgres://aione:password@localhost:5432/aione
# DATABASE_MIGRATION_URL: owner-role connection used only by
# `pnpm --filter @aione/db migrate`. Never used by apps/api or apps/worker
# at runtime.
DATABASE_MIGRATION_URL=postgres://aione:password@localhost:5432/aione

# Worker
WORKER_PORT=3002

# API
API_PORT=3001
API_URL=http://localhost:3001

# Clerk (optional for vertical slice)
CLERK_SECRET_KEY=

# MCP (stub for Phase 2+)
GITHUB_MCP_TOKEN=
