# AIOne — environment variables
#
# Copy this file to `.env` at the repo root and fill in real values there.
# `.env` is gitignored (see .gitignore); this file documents variable
# names only — never real values or secrets (CLAUDE.md rule #2).
#
# apps/api, apps/worker, and packages/db (via
# packages/db/src/set-app-role-password.ts) all load `.env` from the repo
# root via dotenv, resolved relative to their own source file regardless
# of cwd — see the comment at the top of each of their entry points.

# --- Database (packages/db, apps/api) ---

# Runtime connection string for the least-privilege `aione_app` role.
# SELECT/INSERT/UPDATE/DELETE on most tables; SELECT/INSERT only on
# `approvals` (UPDATE/DELETE are REVOKEd at the database level — see
# packages/db/drizzle/0001_sharp_scalphunter.sql). Read by @aione/db's
# runtime client (packages/db/src/index.ts) and by apps/api.
DATABASE_URL=postgres://aione_app:<password>@localhost:5432/aione

# Owner/migration connection string. Full rights, including on
# `approvals`. Used to run migrations (packages/db/src/migrate.ts,
# packages/db/drizzle.config.ts) and to set the aione_app role's password
# out-of-band (packages/db/src/set-app-role-password.ts). Never use this
# role at request-serving runtime — only for schema setup/teardown.
DATABASE_MIGRATION_URL=postgres://aione:password@localhost:5432/aione

# Password for the `aione_app` role, applied out-of-band by
# packages/db/src/set-app-role-password.ts after migrations run — the
# migration itself deliberately leaves this role's password unset (see
# CLAUDE.md rule #2, and the comment above migration
# 0001_sharp_scalphunter.sql). Required locally after a fresh
# `pnpm --filter @aione/db migrate`; in CI this comes from the
# AIONE_APP_DB_PASSWORD GitHub Actions secret instead of this file.
AIONE_APP_DB_PASSWORD=

# --- API (apps/api) ---

# Port the Hono API server listens on (apps/api/src/index.ts). Defaults
# to 3001 if unset.
API_PORT=3001

# Clerk secret key. Read internally by @clerk/hono's clerkMiddleware()
# (apps/api/src/app.ts) to verify session tokens on every request; must
# be set before app.ts is imported.
CLERK_SECRET_KEY=

# --- Model provider (packages/core, used by apps/worker's orchestrator) ---

# Anthropic API key for the Anthropic model provider
# (packages/core/src/providers/anthropic/index.ts). Required for the
# worker's agent orchestration loop to make model calls.
ANTHROPIC_API_KEY=
